---
import "../../styles.css";

import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import BackImg from "../components/BackImg.astro";

import { courses, plarforms, sites } from "../data/courses";
---

<Layout title="Welcome to Astro.">
  <main>
    <BackImg />
    <h1>My courses powered by <span class="text-gradient">Astro</span></h1>
    <p class="instructions">
      To get started, visit the Github reposetory <a
        href="https://github.com/jjreina/Courses"
        target="_blank"><code>https://github.com/jjreina/Courses</code></a
      ><br />
    </p>
    <ul role="list" class="link-card-grid">
      {
        plarforms.map((platform, index) => (
          <Card
            href={sites[index]}
            title={`Platform → ${platform}`}
            body={courses[index]}
          />
        ))
      }
    </ul>
  </main>
</Layout>
